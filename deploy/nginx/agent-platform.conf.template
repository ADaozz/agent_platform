# /etc/nginx/sites-available/agent-platform.conf 的模板
# 由 deploy/scripts/install-host.sh 用 envsubst 渲染（域名、证书路径、站点根目录、
# 后端地址、ACME 目录等占位符会被替换）。端口规划见 docs/DEPLOY.md。

upstream agent_platform_backend {
    server ${BACKEND_ADDR};
    keepalive 16;
}

# ---------------------------------------------------------------------------
# 80：只做 ACME 校验与跳转
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root ${ACME_WEBROOT};
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# 443：SPA 静态资源 + /api 反向代理
# 不启用 mTLS；客户端证书只在 8443 由 nginx 自己解析，并从本端口清除伪造头
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:AGENT_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root ${WEB_ROOT};
    index index.html;

    # 上传：单文件 20MB、单条消息最多 10 个
    client_max_body_size 220m;
    client_body_timeout 300s;

    server_tokens off;

    # 静态资源压缩：dist 里 three.js / echarts 体积较大，gzip 后约降到 1/3
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/xml image/svg+xml application/wasm;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    ${HSTS_HEADER}

    # 外部伪造的证书头一律清空（后端只信任 8443 写入的值）
    proxy_set_header X-Client-Verify "";
    proxy_set_header X-Client-Cert "";
    proxy_set_header X-Client-DN "";

    # Agent Runtime 网关：SSE 长连接 + 文件上传下载
    # 只剥掉 /api 前缀（与前端 vite proxy 一致），后端实际路径是 /agent-runtime/**
    # 不能用缓冲，否则事件流要等连接关闭才到浏览器
    location /api/agent-runtime/ {
        proxy_pass http://agent_platform_backend/agent-runtime/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Client-Verify "";
        proxy_set_header X-Client-Cert "";
        proxy_set_header X-Client-DN "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 1d;
        proxy_read_timeout 1d;
    }

    # 其余后端接口：/api/login → 后端 /login
    location /api/ {
        proxy_pass http://agent_platform_backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Client-Verify "";
        proxy_set_header X-Client-Cert "";
        proxy_set_header X-Client-DN "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # 带 hash 的构建产物可以长期缓存（expires 不会覆盖上面的 add_header）
    location /assets/ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }

    # index.html 必须每次回源，避免升级后仍加载旧 chunk
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    # SPA history 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 8443 客户端证书登录（CERT_LOGIN_ENABLED=true 时由安装脚本写入，否则为空文件）
include /etc/nginx/snippets/agent-platform-cert-login.conf;
