# 部署参数（复制到 /etc/agent-platform/deploy.env 后按实际填写）
#
#   sudo cp deploy/deploy.env.example /etc/agent-platform/deploy.env
#   sudo chmod 600 /etc/agent-platform/deploy.env
#
# 所有 deploy/scripts/*.sh 都会 source 本文件；下面的变量名不要改。
# 本文件只是参数，不放密钥：JWT / HMAC / Redis 密码由 install-host.sh
# 生成到 /etc/agent-platform/secrets.env（600）。

# ---- 站点 ----
# 域名，或直接填公网 IPv4（例如 203.0.113.10）。
# 填 IP 时：只签发自签证书（Let's Encrypt 不支持 IP）、自动关闭 HSTS，
# 浏览器第一次访问会提示证书不受信任。细节见 docs/DEPLOY.md「只用 IP 访问」。
DOMAIN=agent.example.com
# Let's Encrypt 到期通知邮箱（IP 模式下不使用）
ACME_EMAIL=ops@example.com
# Let's Encrypt 校验目录
ACME_WEBROOT=/var/www/letsencrypt

# ---- 邮件（自助注册验证码；163 邮箱填客户端授权码，不是登录密码）----
# install-host.sh 会把这两项写进 secrets.env（600）。留空则注册验证码不可用。
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 唯一管理员（deploy/scripts/set-admin.sh 使用）----
# 内置种子账号是 admin/123456，公网必须先换掉。install-host 之后执行：
#   sudo deploy/scripts/set-admin.sh
# 它会把账号收敛成下面这一个管理员，并删除其它账号（--keep-others 可保留）。
# 跑完请把本行密码清空，明文不要留在机器上。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- 路径 ----
APP_ROOT=/opt/agent-platform
DATA_ROOT=/var/lib/agent-platform
ETC_ROOT=/etc/agent-platform
SERVICE_USER=agent-platform

# ---- 端口（8080 / 8090 只绑 127.0.0.1，绝不对公网开放）----
BACKEND_PORT=8080
RUNTIME_PORT=8090
REDIS_PORT=6379

# ---- TLS 服务端证书（证书登录与 HTTPS 都用它）----
# 默认由 issue-tls-cert.sh 从 Let's Encrypt 复制到这里，nginx 直接引用副本；
# 也可改成自有证书路径。install-host.sh 发现文件不存在时会先放一张自签占位证书，
# 让 nginx 能先起来。
TLS_CERT=${ETC_ROOT}/tls/fullchain.pem
TLS_KEY=${ETC_ROOT}/tls/privkey.pem

# ---- 客户端证书登录（8443）----
# false：不监听 8443，只开放账号密码与邮箱注册
CERT_LOGIN_ENABLED=true
# 客户端 CA 信任链（PEM，可含多张 CA；只要证书，不要私钥）。
# install-host.sh 会尝试从 CA_SOURCE_DIR 拼装；也可直接把现成 bundle 放到该路径。
TLS_CLIENT_CA=${ETC_ROOT}/tls/client-ca-bundle.crt
# 存放 root-ca.crt / intermediate-ca.crt / intermediate-ca.key 的目录（可留空）
CA_SOURCE_DIR=

# ---- Redis 数据、日志与配置文件（必须是本机磁盘，不要放 /mnt/c 之类 DrvFs 挂载）----
REDIS_CONF=/etc/redis/agent-platform.conf
REDIS_DATA_DIR=/var/lib/redis/agent-platform
REDIS_LOG_DIR=/var/log/redis

# ---- 可选组件 ----
# true：额外安装 LibreOffice 与中文字体（DOCX/PPTX 正式分页渲染，68 个包、装完约 410MB）
INSTALL_OFFICE=false
# true：额外安装 Maven + JDK，允许直接在本机构建 jar
INSTALL_BUILD_TOOLS=false
