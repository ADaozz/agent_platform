# /etc/agent-platform/backend.env 的模板（不含密钥；密钥在 secrets.env）
# 由 deploy/scripts/install-host.sh 用 envsubst 渲染

# Spring profile：prod 只绑回环，sqlite 用 SQLite 代替 KingbaseES
SPRING_PROFILES_ACTIVE=prod,sqlite

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=${BACKEND_PORT}

# 堆大小按机器内存调整（4GB 机器用 -Xmx2g，8GB 用 -Xmx4g）。
# 注意：JDK 8 不支持 -XX:MaxRAMPercentage，只认 -Xmx / -XX:MaxRAMFraction，写错会导致 JVM 直接起不来。
JAVA_OPTS=-Xms256m -Xmx2g -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# SQLite：date_class/date_string_format 必须保留，否则 MyBatis 读取时间会报错
DB_URL=jdbc:sqlite:${DATA_ROOT}/data/agent-platform.db?date_class=TEXT&date_string_format=yyyy-MM-dd HH:mm:ss
DB_USERNAME=
DB_PASSWORD=

# 客户端证书签发目录与 CA 材料（CERT_LOGIN_ENABLED=false 时可以不配置）
CERT_STORAGE_BASE=${DATA_ROOT}/certs
CERT_INTERMEDIATE_CERT=${ETC_ROOT}/ca/intermediate-ca.crt
CERT_INTERMEDIATE_KEY=${ETC_ROOT}/ca/intermediate-ca.key
CERT_ROOT_CERT=${ETC_ROOT}/ca/root-ca.crt

REDIS_HOST=127.0.0.1
REDIS_PORT=${REDIS_PORT}
REDIS_DATABASE=0

# 注册验证码发件邮箱（163 用授权码；账号密码写在 secrets.env）
MAIL_HOST=smtp.163.com
MAIL_PORT=465

# 证书登录：启用时 public-origin 与 allowed-origins 必须是精确 HTTPS Origin
# （域名或 IP 都行，但必须带 https://、无路径），否则后端拒绝启动（见 docs/DEPLOY.md）
# allowed-origins 额外带上 https://localhost：WSL / 本机用 localhost 打开时，
# 回跳必须回到 localhost；只写公网 Origin 会 302 到公网地址，本机访问会卡住。
CERT_LOGIN_ENABLED=${CERT_LOGIN_ENABLED}
CERT_LOGIN_TRUSTED_PROXIES=127.0.0.1,::1
CERT_LOGIN_PUBLIC_ORIGIN=https://${DOMAIN}
CERT_LOGIN_ALLOWED_ORIGINS=https://${DOMAIN},https://localhost

# Agent Runtime 只在内网回环
AGENT_RUNTIME_URL=http://127.0.0.1:${RUNTIME_PORT}

# 个人模型 SSRF 白名单（可留空：仍拒绝回环/私网，且只允许 https）
# PERSONAL_MODEL_ALLOWED_HOSTS=api.deepseek.com
