# /etc/agent-platform/runtime.env 的模板（不含密钥；密钥在 secrets.env）
# 由 deploy/scripts/install-host.sh 用 envsubst 渲染

# 平台数据目录：模型配置、加密密钥、会话 checkpoint、workspace 都在这里
PLATFORM_DATA_DIR=${DATA_ROOT}/runtime
HOME=${DATA_ROOT}/runtime
TMPDIR=${DATA_ROOT}/runtime/tmp

# 个人模型只允许访问这些主机（留空则只做私网/回环拦截）
PERSONAL_MODEL_ALLOWED_HOSTS=

# 可选：把模型配置放在文件里（网页保存的配置优先）
# PLATFORM_CONFIG=${ETC_ROOT}/runtime-config.yaml
