{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOCX document plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "document_id",
    "title",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "document_id": {
      "type": "string",
      "pattern": "^[\\w.-]{1,80}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "page_target": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "design": {
      "type": "string",
      "maxLength": 500
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "requirements",
          "block_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "requirements": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "block_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500,
            "minItems": 1
          },
          "equations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          },
          "figures": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,80}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          },
          "kind": {
            "enum": [
              "cover",
              "abstract",
              "toc",
              "body",
              "references",
              "appendix"
            ]
          },
          "single_page": {
            "type": "boolean"
          },
          "numbering": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format"
            ],
            "properties": {
              "format": {
                "enum": [
                  "decimal",
                  "lowerRoman",
                  "upperRoman",
                  "none"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              }
            }
          },
          "continued_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]{1,80}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        }
      }
    }
  }
}
